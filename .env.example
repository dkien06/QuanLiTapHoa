# Cấu hình môi trường phát triển (Development Environment)
ENVIRONMENT=development
API_PORT=8000

# Kết nối CSDL (SQLite cho dev nhanh hoặc MSSQL cho production)
DATABASE_URL=sqlite:///./taphoa.db
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost:1433/QuanLiTapHoa?driver=ODBC+Driver+17+for+SQL+Server

# JWT Secret Key
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
